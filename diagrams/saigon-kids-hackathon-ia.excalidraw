    },
    {
      "id": "el00ej",
      "type": "text",
      "x": 2102,
      "y": 6750,
      "width": 449.28000000000003,
      "height": 118.125,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "el00ay",
      "index": "a00523",
      "roundness": null,
      "seed": 1795623890,
      "version": 1,
      "versionNonce": 2718054665,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "on every pathname change:\n  1. await document.fonts.ready\n  2. two nested requestAnimationFrames (pins must have measured)\n  3. ScrollTrigger.refresh()\n  4. scrollToHash(hash, true) — then AGAIN one rAF later,\n     because the pins re-measure once the page has moved\n  5. otherwise scrollToTop, unless popstate or first mount",
      "originalText": "on every pathname change:\n  1. await document.fonts.ready\n  2. two nested requestAnimationFrames (pins must have measured)\n  3. ScrollTrigger.refresh()\n  4. scrollToHash(hash, true) — then AGAIN one rAF later,\n     because the pins re-measure once the page has moved\n  5. otherwise scrollToTop, unless popstate or first mount",
      "fontSize": 13.5,
      "fontFamily": 5,
      "textAlign": "left",
