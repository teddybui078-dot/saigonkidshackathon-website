    {
      "id": "el00h5",
      "type": "text",
      "x": 2302,
      "y": 8781.25,
      "width": 484.38,
      "height": 253.125,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "el00g7",
      "index": "a00617",
      "roundness": null,
      "seed": 2332254590,
      "version": 1,
      "versionNonce": 700521157,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "components opt in by classname; the driver is mounted per page.\n\n.ambient-float     drift y +10–22, x ±14, rot ±5, 2.8–5.5s yoyo\n                   data-amp=\"s\" halves it for in-card elements\n.ambient-twinkle   scale 0.55→1.15, opacity 0.35→1\n.ambient-sway      rot 2–3°, origin 50% 100% (palms rock from base)\n.ambient-hang      rot ±1.5, origin 50% 0% (lanterns swing from hook)\n.marquee-bulb      opacity chase, stagger each 0.12\n.anchor-drift      section anchors drift y +14–20\n.anchor-wobble     rot ±6 (laptop, planets)\n.anchor-wiggle     rot 5→18, 2.2s (the question mark, a pendulum)\n.anchor-beat       4-step heartbeat 1.12→1→1.08→1, repeatDelay 1.2\n.bulb-ray          opacity 0.3→1, scale 0.85→1.05\n.clock-hand-m      rotation +=360 over 12s\n.clock-hand-h      rotation +=360 over 144s — correctly geared 12×",
      "originalText": "components opt in by classname; the driver is mounted per page.\n\n.ambient-float     drift y +10–22, x ±14, rot ±5, 2.8–5.5s yoyo\n                   data-amp=\"s\" halves it for in-card elements\n.ambient-twinkle   scale 0.55→1.15, opacity 0.35→1\n.ambient-sway      rot 2–3°, origin 50% 100% (palms rock from base)\n.ambient-hang      rot ±1.5, origin 50% 0% (lanterns swing from hook)\n.marquee-bulb      opacity chase, stagger each 0.12\n.anchor-drift      section anchors drift y +14–20\n.anchor-wobble     rot ±6 (laptop, planets)\n.anchor-wiggle     rot 5→18, 2.2s (the question mark, a pendulum)\n.anchor-beat       4-step heartbeat 1.12→1→1.08→1, repeatDelay 1.2\n.bulb-ray          opacity 0.3→1, scale 0.85→1.05\n.clock-hand-m      rotation +=360 over 12s\n.clock-hand-h      rotation +=360 over 144s — correctly geared 12×",
      "fontSize": 13.5,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
