    {
      "id": "el00ef",
      "type": "text",
      "x": 2102,
      "y": 6436,
      "width": 568.62,
      "height": 185.625,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "el00ay",
      "index": "a00519",
      "roundness": null,
      "seed": 280612586,
      "version": 1,
      "versionNonce": 1395241281,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "splitHref(\"/#faq\") → [\"/\", \"#faq\"];  samePage = path === \"\" || path === pathname\n\nsame page + hash  → lenis.resize(), then lenis.scrollTo(pageTop(el) + NAV_OFFSET)\n                    NAV_OFFSET = −72 clears the fixed navbar\n                    pageTop() walks offsetTop, not getBoundingClientRect, so an\n                    in-flight entrance transform can't skew the target\nsame page, no hash → scrollToTop()\ncross-route        → next/link with scroll={hash ? false : undefined}\n                    hash links opt out so RouteScroll can seat them\n\nbails on meta/ctrl/shift/alt + non-primary button → cmd-click still opens a tab",
      "originalText": "splitHref(\"/#faq\") → [\"/\", \"#faq\"];  samePage = path === \"\" || path === pathname\n\nsame page + hash  → lenis.resize(), then lenis.scrollTo(pageTop(el) + NAV_OFFSET)\n                    NAV_OFFSET = −72 clears the fixed navbar\n                    pageTop() walks offsetTop, not getBoundingClientRect, so an\n                    in-flight entrance transform can't skew the target\nsame page, no hash → scrollToTop()\ncross-route        → next/link with scroll={hash ? false : undefined}\n                    hash links opt out so RouteScroll can seat them\n\nbails on meta/ctrl/shift/alt + non-primary button → cmd-click still opens a tab",
      "fontSize": 13.5,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
