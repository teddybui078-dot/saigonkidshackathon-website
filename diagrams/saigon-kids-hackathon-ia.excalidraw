      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "SceneBackdrop renders motionless markup carrying .ambient-float /\n.ambient-twinkle classes that AmbientMotion picks up by selector.\nPartyPopper, PixelClock and PixelBulb embed hook classes directly\nin their SVG internals.\n\nSo the static illustration modules still participate in motion.",
      "originalText": "SceneBackdrop renders motionless markup carrying .ambient-float /\n.ambient-twinkle classes that AmbientMotion picks up by selector.\nPartyPopper, PixelClock and PixelBulb embed hook classes directly\nin their SVG internals.\n\nSo the static illustration modules still participate in motion.",
      "fontSize": 13.5,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
